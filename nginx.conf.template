# Plain HTTP: only the ACME challenge is served directly (certbot's renewal
# needs port 80, unencrypted, before the 443 listener can even be assumed to
# exist) - everything else redirects to HTTPS. Without this, a request that
# lands on port 80 (someone typing the bare domain, an old bookmark, no
# scheme in a link) gets the *entire site* served with no TLS at all, which
# Chrome correctly flags as "Not Secure" regardless of how valid the 443
# cert is - the browser was never on an encrypted connection to begin with.
server {
    listen 80;
    server_name localhost;

    # ACME HTTP-01 challenge for the Let's Encrypt cert (see
    # docker-entrypoint.d/15-enable-tls.sh and deployment/main.tf's
    # "acme-challenge" volume). Safe to ship unconditionally: an empty or
    # missing webroot just 404s, it doesn't crash nginx the way a missing
    # ssl_certificate file on the 443 side would. Kept out of the redirect
    # below since it must stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Unconditional, unlike the 443 listener's own conditional promotion
    # (see docker-entrypoint.d/15-enable-tls.sh) - a brand-new environment
    # with no cert yet would redirect to a port that isn't listening. That's
    # an acceptable tradeoff here: the one-time certbot setup runs
    # immediately after a fresh deploy (see deployment runbook), before real
    # traffic exists, and every already-provisioned environment (this one
    # included) has a cert well before anyone hits this path.
    location / {
        return 301 https://$host$request_uri;
    }
}
