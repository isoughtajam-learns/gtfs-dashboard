server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;
    gzip_disable "MSIE [1-6]\.";

    # Use Docker's internal DNS resolver
    resolver 127.0.0.11 valid=30s;

    # Reverse proxy for API requests using envsubst variable
    location /api/ {
        # Using a variable forces Nginx to resolve the DNS at runtime instead of startup,
        # preventing crashes if the backend isn't running yet.
        set $upstream ${BACKEND_URL};
        # BACKEND_URL has no path component, so nginx would forward the URI verbatim
        # and the backend would see /api/trip_updates/... . Strip the prefix here.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_http_version 1.1;

        # SSE: never buffer the stream, and don't cut it off during quiet stretches.
        # (The backend also sends X-Accel-Buffering: no.)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve static files and fallback to index.html for React Router
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Caching for static assets
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
    }
}
